APP_VERSION=0.2.0
APP_ENV=production
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
OTP_DELIVERY_MODE=smtp

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=jobops@example.com
SMTP_PASSWORD=change-this-smtp-password
SMTP_FROM=jobops@example.com
SMTP_FROM_NAME=JobOps Tracker

POSTGRES_DB=jobops
POSTGRES_USER=jobops
POSTGRES_PASSWORD=change-this-password

VITE_API_BASE_URL=/api

# Local production test:
# JOBOPS_SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Real VPS:
# JOBOPS_SITE_ADDRESS=jobops.yourdomain.com
# HTTP_PORT=80
# HTTPS_PORT=443

JOBOPS_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
ACME_EMAIL=admin@example.com
