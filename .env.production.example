APP_VERSION=0.2.0
JOBOPS_DEPLOY_MODE=build
BACKEND_IMAGE=jobops-tracker-backend:0.2.0
FRONTEND_IMAGE=jobops-tracker-frontend:0.2.0
CAPTURE_OCR_IMAGE=jobops-capture-ocr:latest
APP_ENV=production
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_SECURE=false
OTP_DELIVERY_MODE=smtp
CORS_ALLOWED_ORIGINS=https://jobops.me,https://www.jobops.me
CAPTURE_ANALYZE_ENABLED=true
CAPTURE_OCR_URL=http://capture-ocr:8090
CAPTURE_MAX_BYTES=6000000

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=jobops@example.com
SMTP_PASSWORD=change-this-smtp-password
SMTP_FROM=jobops@example.com
SMTP_FROM_NAME=JobOps Tracker

POSTGRES_DB=jobops
POSTGRES_USER=jobops
POSTGRES_PASSWORD=change-this-password

VITE_API_BASE_URL=/api

# Local production test:
# JOBOPS_SITE_ADDRESS=:80
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Real VPS:
# JOBOPS_SITE_ADDRESS=jobops.yourdomain.com
# HTTP_PORT=80
# HTTPS_PORT=443
#
# Pinned GHCR image deploy:
# JOBOPS_DEPLOY_MODE=pull
# BACKEND_IMAGE=ghcr.io/krishnatejacheruku/jobops-tracker-backend:vX.Y.Z
# FRONTEND_IMAGE=ghcr.io/krishnatejacheruku/jobops-tracker-frontend:vX.Y.Z
# CAPTURE_OCR_IMAGE=ghcr.io/krishnatejacheruku/jobops-capture-ocr:vX.Y.Z

JOBOPS_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
ACME_EMAIL=admin@example.com
