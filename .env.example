# App
APP_NAME=jobops-tracker
APP_ENV=development
APP_DEBUG=true

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
AUTH_SECRET=jobops-dev-auth-secret-change-me
AUTH_COOKIE_SECURE=false
OTP_DELIVERY_MODE=log

# SMTP OTP delivery, required when OTP_DELIVERY_MODE=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=JobOps Tracker

# Frontend
FRONTEND_PORT=3000

# Database
POSTGRES_DB=jobops
POSTGRES_USER=jobops
POSTGRES_PASSWORD=jobops_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://jobops:jobops_dev_password@postgres:5432/jobops

# Local cloud emulator - later phase
FLOCI_ENDPOINT_URL=http://floci:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
